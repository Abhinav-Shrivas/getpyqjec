# ==============================================================================
# GETPYQJEC — Environment Variables Template
# ==============================================================================
# Instructions:
# 1. For Local Development: Copy this file to .env and fill in the values.
# 2. For Production (Render): Set these variables in the Render Dashboard.
# 3. For Production (Vercel): Set VITE_API_BASE_URL in the Vercel Dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Settings (Django / Render)
# ------------------------------------------------------------------------------

# Django secret key (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=django-insecure-change-this-in-production

# Debug mode: True for local development, False for production (Render)
DEBUG=True

# Allowed hosts: comma-separated list of allowed domains (e.g., getpyqjec.onrender.com,localhost,127.0.0.1)
# On Render, RENDER_EXTERNAL_HOSTNAME is automatically added if present.
ALLOWED_HOSTS=localhost,127.0.0.1

# Deployed frontend base URL (used for CORS, CSRF, and password reset links)
# Development: http://localhost:5173
# Production: https://<your-vercel-domain>.vercel.app
FRONTEND_BASE_URL=http://localhost:5173

# Database URL:
# Development fallback: sqlite:///db.sqlite3 (if left unset)
# Production (NeonDB PostgreSQL): postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Google Drive Configuration
# OPTION A: For personal @gmail.com accounts (15 GB free personal Drive):
# Generate with: python get_oauth_token.py
GOOGLE_DRIVE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=your_oauth_refresh_token

# OPTION B: For Google Workspace accounts with Shared Drives (Service Account):
GOOGLE_DRIVE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Dedicated Google Drive root folder ID for GETPYQJEC
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Email Configuration (SMTP / Gmail)
EMAIL_HOST_USER=opensourcejec@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password_here

# ------------------------------------------------------------------------------
# Frontend Settings (React / Vite / Vercel)
# ------------------------------------------------------------------------------

# API Base URL for React frontend to communicate with Django API
# Development: http://localhost:8000
# Production: https://<your-render-backend-name>.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Optional LAN IP for mobile testing during development (e.g. 192.168.1.5)
VITE_HOST_IP=
