# ==============================================================================
# GETPYQJEC — Environment Variables Template
# ==============================================================================
# For Local Development:
# Copy this file to .env. Everything works out of the box with zero cloud setup!
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Local Development (Zero Cloud Keys Needed)
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-local-dev-key
CONTRIBUTOR_MODE=True
FRONTEND_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
VERIFICATION_MAX_IMAGE_SIZE_MB=2

# ------------------------------------------------------------------------------
# Production Deployment Only (Render / NeonDB / Cloudflare / Resend)
# Leave these commented out for local development.
# ------------------------------------------------------------------------------
# DATABASE_URL=neondb_url
# RESEND_API_KEY=re_your_api_key_here
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_PYQ_BUCKET=getpyqjec-pyqs
# R2_VERIFICATION_BUCKET=getpyqjec-verifications
