# ==============================================================================
# GETPYQJEC — Environment Variables Template
# ==============================================================================
# Instructions:
# 1. For Local Development: Copy this file to .env and fill in the values.
# 2. For Production (Render): Set these variables in the Render Dashboard.
# 3. For Production (Vercel): Set VITE_API_BASE_URL in the Vercel Dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Settings (Django / Render)
# ------------------------------------------------------------------------------

# Django secret key (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=django-insecure-change-this-in-production

# Debug mode: True for local development, False for production (Render)
DEBUG=True

# Allowed hosts: comma-separated list of allowed domains (e.g., api.getpyqjec.in,getpyqjec.onrender.com,localhost,127.0.0.1)
# IMPORTANT: Do NOT include 'https://' or trailing slashes in ALLOWED_HOSTS!
ALLOWED_HOSTS=localhost,127.0.0.1,api.getpyqjec.in,.getpyqjec.in

# Deployed frontend base URL (used for CORS, CSRF, and password reset / verification email links)
# Development: http://localhost:5173
# Production: https://www.getpyqjec.in
FRONTEND_BASE_URL=https://www.getpyqjec.in

# Database URL:
# Development fallback: sqlite:///db.sqlite3 (if left unset)
# Production (NeonDB PostgreSQL): postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Email Configuration (SMTP / Gmail)
EMAIL_HOST_USER=your_gmail
EMAIL_HOST_PASSWORD=your_gmail_app_password_here

# ------------------------------------------------------------------------------
# Cloudflare R2 Storage Configuration
# ------------------------------------------------------------------------------

# Your Cloudflare Account ID (visible in the Cloudflare dashboard URL)
R2_ACCOUNT_ID=your_cloudflare_account_id

# R2 API Token credentials (create at: Cloudflare Dashboard → R2 → Manage R2 API Tokens)
# Restrict token permissions to the two buckets listed below.
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# R2 S3-compatible endpoint (auto-derived from account ID if not set)
# Format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# R2 Bucket names (create these in the Cloudflare R2 dashboard)
R2_PYQ_BUCKET= bucket_name
R2_VERIFICATION_BUCKET= bucket_name

# Presigned URL expiry in seconds (default: 3600 = 1 hour)
R2_PRESIGNED_URL_EXPIRY=3600

# ------------------------------------------------------------------------------
# Verification Settings
# ------------------------------------------------------------------------------

# Maximum upload size for ID card images in MB
VERIFICATION_MAX_IMAGE_SIZE_MB=2

# ------------------------------------------------------------------------------
# Frontend Settings (React / Vite / Vercel)
# ------------------------------------------------------------------------------

# API Base URL for React frontend to communicate with Django API
# Development: http://localhost:8000
# Production: https://<your-render-backend-name>.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Optional LAN IP for mobile testing during development (e.g. 192.168.1.5)
VITE_HOST_IP=
